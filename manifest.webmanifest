{
  "name": "KratzerScan Viewer",
  "short_name": "KratzerScan",
  "description": "Schadensberichte von KratzerScan ansehen – 3D-Modell mit markierten Schäden, Bauteile, Empfehlung",
  "lang": "de",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#EEF2EE",
  "theme_color": "#15202A",
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "share_target": {
    "action": "./teilen",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {"files": [{"name": "bericht", "accept": [".glb", "model/gltf-binary", "application/octet-stream"]}]}
  },
  "file_handlers": [
    {"action": "./", "accept": {"model/gltf-binary": [".glb"]}}
  ]
}
